APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Multi-domain setup (Ajinsafro)
# ADMIN_URL is used for storage URLs and admin portal
ADMIN_URL=https://booking.ajinsafro.net
# PUBLIC_STORAGE_URL overrides the public disk URL if set
# PUBLIC_STORAGE_URL=https://booking.ajinsafro.net/storage

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nazox_laravel_v1.1.0
DB_USERNAME=root
DB_PASSWORD=

# WordPress (same DB as front: WP_TABLE_PREFIX must match wp-config.php $table_prefix)
WP_TABLE_PREFIX=wp_
WP_DB_PREFIX=wp_
WP_DB_HOST=
WP_DB_DATABASE=
WP_DB_USERNAME=
WP_DB_PASSWORD=
WP_UPLOADS_PATH=
WP_UPLOADS_URL=

# WordPress plugin ajinsafro-traveler-home: same secret as option ajth_laravel_invalidate_secret (WP admin → Laravel & debug API)
WP_CATALOG_INVALIDATE_URL=
WP_CATALOG_INVALIDATE_SECRET=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# API Hôtels externe (GET /hotels)
HOTEL_API_KEY=
HOTEL_API_BASE_URL=
# HOTEL_API_TIMEOUT=20

# RateHawk / ETG — Basic Auth (KEY_ID:API_KEY) — POST .../search/serp/region/
RATEHAWK_KEY_ID=
RATEHAWK_API_KEY=
RATEHAWK_API_BASE_URL=https://api.worldota.net
# RATEHAWK_TIMEOUT=45
# RATEHAWK_CONNECT_TIMEOUT=15
# TLS : true en prod. En local uniquement si cURL 60 (certificat) : RATEHAWK_VERIFY_SSL=false
# RATEHAWK_VERIFY_SSL=true
# RATEHAWK_DEFAULT_RESIDENCY=ma
# RATEHAWK_DEFAULT_CURRENCY=MAD
# RATEHAWK_LANGUAGE=fr
# RATEHAWK_HOTELS_LIMIT=30

