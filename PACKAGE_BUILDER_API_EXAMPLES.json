{
  "api_examples": {
    "1_get_package_state": {
      "description": "Récupérer l'état initial du package pour un voyage",
      "method": "GET",
      "url": "/api/public/tours/1/package-state?pax_adults=2&pax_children=1&currency=MAD",
      "response": {
        "success": true,
        "data": {
          "tour": {
            "id": 1,
            "name": "Circuit Découverte Dubai",
            "total_days": 7
          },
          "session": {
            "id": "uuid-here",
            "pax_adults": 2,
            "pax_children": 1,
            "currency": "MAD"
          },
          "pricing": {
            "base_per_person": 850000,
            "total_per_person": 850000,
            "total_group": 1700000,
            "currency": "MAD"
          }
        }
      }
    },
    "2_add_optional_activity": {
      "description": "Ajouter une activité optionnelle (Safari désert)",
      "method": "POST",
      "url": "/api/public/package/session/{session_id}/action",
      "body": {
        "action": "add",
        "add_data": {
          "day_number": 3,
          "type": "activity",
          "title": "Safari dans le désert avec dîner BBQ",
          "details": "Excursion 4x4 dans les dunes + spectacle traditionnel + dîner BBQ sous les étoiles",
          "price_delta_per_person": 8000
        }
      },
      "response": {
        "success": true,
        "message": "Action effectuée avec succès.",
        "data": {
          "pricing": {
            "base_per_person": 850000,
            "options_per_person": 8000,
            "total_per_person": 858000,
            "total_group": 1716000,
            "delta_last_action": 8000
          },
          "session": {
            "state": {
              "added_items": [
                {
                  "day_number": 3,
                  "type": "activity",
                  "title": "Safari dans le désert avec dîner BBQ",
                  "price_delta_per_person": 8000
                }
              ]
            }
          }
        }
      }
    },
    "3_remove_meal": {
      "description": "Retirer un repas non souhaité",
      "method": "POST",
      "url": "/api/public/package/session/{session_id}/action",
      "body": {
        "action": "remove",
        "item_id": 42
      },
      "response": {
        "success": true,
        "message": "Action effectuée avec succès.",
        "data": {
          "pricing": {
            "delta_last_action": -2000,
            "total_per_person": 856000
          },
          "session": {
            "state": {
              "removed_items": [42]
            }
          }
        }
      }
    },
    "4_modify_hotel_upgrade": {
      "description": "Upgrade vers un hôtel 5 étoiles",
      "method": "POST",
      "url": "/api/public/package/session/{session_id}/action",
      "body": {
        "action": "modify",
        "item_id": 3,
        "new_option": {
          "title": "Upgrade hôtel 5* Burj Al Arab",
          "price_delta": 50000
        }
      },
      "response": {
        "success": true,
        "message": "Action effectuée avec succès.",
        "data": {
          "pricing": {
            "options_per_person": 50000,
            "total_per_person": 900000,
            "total_group": 1800000,
            "delta_last_action": 50000
          },
          "session": {
            "state": {
              "modified_items": {
                "3": {
                  "title": "Upgrade hôtel 5* Burj Al Arab",
                  "price_delta": 50000
                }
              }
            }
          },
          "days": [
            {
              "items": [
                {
                  "id": 3,
                  "type": "hotel_stay",
                  "title": "Hôtel 4* - Downtown Dubai",
                  "active_option": {
                    "title": "Upgrade hôtel 5* Burj Al Arab",
                    "price_delta": 50000
                  }
                }
              ]
            }
          ]
        }
      }
    },
    "5_create_checkout": {
      "description": "Créer un token de checkout avec verrouillage du prix",
      "method": "POST",
      "url": "/api/public/checkout/create",
      "body": {
        "session_id": "9a5c3e40-1234-5678-90ab-cdef12345678"
      },
      "response": {
        "success": true,
        "data": {
          "checkout_token": "chk_a7b3c9d1e2f4g5h6i7j8k9l0m1n2o3p4",
          "redirect_url": "https://example.com/booking/checkout/chk_a7b3c9d1e2f4g5h6i7j8k9l0m1n2o3p4",
          "expires_at": "2026-02-03T11:15:00+00:00",
          "remaining_seconds": 900
        }
      }
    },
    "6_error_expired_session": {
      "description": "Erreur quand la session a expiré",
      "method": "POST",
      "url": "/api/public/package/session/{session_id}/action",
      "body": {
        "action": "add",
        "add_data": {}
      },
      "response": {
        "success": false,
        "message": "La session a expiré. Veuillez recharger la page."
      },
      "status_code": 410
    }
  },
