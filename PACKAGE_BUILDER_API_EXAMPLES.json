  "usage_scenarios": {
    "scenario_1_family_booking": {
      "description": "Famille de 2 adultes + 2 enfants réserve le package standard puis ajoute safari désert",
      "steps": [
        {
          "step": 1,
          "action": "GET /api/public/tours/1/package-state?pax_adults=2&pax_children=2",
          "result": "Session créée, prix base: 850000 x 2 = 1700000 MAD"
        },
        {
          "step": 2,
          "action": "POST /api/public/package/session/{id}/action",
          "body": {"action": "add", "add_data": {"day_number": 3, "type": "activity", "title": "Safari désert", "price_delta_per_person": 8000}},
          "result": "Options ajoutées: +8000 x 2 = +16000. Total: 1716000 MAD"
        },
        {
          "step": 3,
          "action": "POST /api/public/checkout/create",
          "body": {"session_id": "uuid"},
          "result": "Token créé, redirect vers checkout"
        }
      ]
    },
    "scenario_2_luxury_upgrade": {
      "description": "Couple upgrade vers hôtel 5* et ajoute repas gastronomique",
      "steps": [
        {
          "step": 1,
          "action": "GET package-state",
          "result": "Session 2 adultes, prix base: 1700000"
        },
        {
          "step": 2,
          "action": "MODIFY hotel item 3 → upgrade_5star",
          "result": "Options: +35000 x 2 = +70000. Total: 1770000"
        },
        {
          "step": 3,
          "action": "ADD meal At.mosphere",
          "result": "Options: +12000 x 2 = +24000. Total: 1794000"
        },
        {
          "step": 4,
          "action": "CREATE checkout",
          "result": "Token + redirect"
        }
      ]
    }
  }
}
