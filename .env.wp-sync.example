# ===================================
# WordPress Bidirectional Sync Config
# ===================================

# Auto-sync enabled (sync on every voyage save)
WP_AUTO_SYNC_ENABLED=true

# HMAC Secret for webhook authentication (generate with: php -r "echo bin2hex(random_bytes(32));" )
WP_WEBHOOK_SECRET=your-secret-key-here-change-this-to-random-64-chars

# Token for manual sync triggers via API
WP_MANUAL_SYNC_TOKEN=your-manual-sync-token-change-this

# WordPress table prefix (IMPORTANT: must match your WP installation)
WP_TABLE_PREFIX=cFdgeZ_

# WordPress site URL
WP_SITE_URL=https://ajinsafro.com

# Database connection name for WordPress (defined in database.php)
WP_DB_CONNECTION=wp

# Conflict resolution strategy (wp_wins | laravel_wins | newest_wins)
WP_SYNC_CONFLICT_RESOLUTION=wp_wins

# Sync options
WP_SYNC_IMAGES=true
WP_SYNC_GALLERY=true
WP_SYNC_TAXONOMIES=true
WP_SYNC_PROGRAM=true
